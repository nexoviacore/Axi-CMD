{
  "openapi": "3.0.1",
  "info": {
    "title": "AxiGIT API",
    "description": "Publishes and retrieves Axi deliverables stored in GitHub Repositories for AxiCmdLine.",
    "version": "v1"
  },
  "paths": {
    "/api/git/listdirectories": {
      "post": {
        "tags": [
          "DirectoryList"
        ],
        "summary": "Lists the Directories and their Versions on the Repository's main branch.",
        "description": "The GitHub PAT comes from server configuration, never from the request.\r\nEach Directory's versions list \"Latest\" first (when present), then Version{N} in numeric order.\r\nAn empty Repository returns 200 with no Directories and a null commitSha.",
        "requestBody": {
          "description": "The Account, Repository and Manager Type to list.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListDirectoriesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The Directories and Versions, with the commit they were read from.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ListDirectoriesResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDirectoriesResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDirectoriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is missing or blank, or the Manager Type is unknown.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The Repository or its main branch was not found, or the configured PAT cannot see it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "GitHub rejected the configured PAT, failed, or could not be reached.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/git/pull": {
      "post": {
        "tags": [
          "GitPull"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PullPackageRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PullPackageRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PullPackageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/git/push": {
      "post": {
        "tags": [
          "GitPush"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushFolderRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PushFolderRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PushFolderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/git/listrepositories": {
      "post": {
        "tags": [
          "RepositoryList"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRepositoriesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRepositoriesRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ListRepositoriesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DirectoryEntry": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ListDirectoriesRequest": {
        "required": [
          "account",
          "managerType",
          "repo"
        ],
        "type": "object",
        "properties": {
          "account": {
            "minLength": 1,
            "type": "string"
          },
          "repo": {
            "minLength": 1,
            "type": "string"
          },
          "managerType": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ListDirectoriesResponse": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "nullable": true
          },
          "repo": {
            "type": "string",
            "nullable": true
          },
          "managerType": {
            "type": "string",
            "nullable": true
          },
          "branch": {
            "type": "string",
            "nullable": true
          },
          "commitSha": {
            "type": "string",
            "nullable": true
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "directoryCount": {
            "type": "integer",
            "format": "int32"
          },
          "directories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirectoryEntry"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ListRepositoriesRequest": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          },
          "managerType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "PullPackageRequest": {
        "type": "object",
        "properties": {
          "physicalPath": {
            "type": "string",
            "nullable": true
          },
          "repoUrl": {
            "type": "string",
            "nullable": true
          },
          "packageName": {
            "type": "string",
            "nullable": true
          },
          "gitBranch": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PushFolderRequest": {
        "type": "object",
        "properties": {
          "physicalPath": {
            "type": "string",
            "nullable": true
          },
          "targetRepo": {
            "type": "string",
            "nullable": true
          },
          "productName": {
            "type": "string",
            "nullable": true
          },
          "productDescription": {
            "type": "string",
            "nullable": true
          },
          "productVersion": {
            "type": "string",
            "nullable": true
          },
          "productAuthor": {
            "type": "string",
            "nullable": true
          },
          "gitBranch": {
            "type": "string",
            "nullable": true
          },
          "managerType": {
            "type": "string",
            "nullable": true
          },
          "ensureRepository": {
            "type": "boolean"
          },
          "compress": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    }
  }
}