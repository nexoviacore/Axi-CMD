{
  "info": {
    "name": "AxList paging and filters (axi_structmetalist)",
    "description": "Checks that the AxList API pages and filters the AxiCMD structure list (ADS axi_structmetalist) through\nAxPEG.aspx/GetDataFromAxList, the endpoint behind GetDataFromAxList() in Js/AxInterface.js.\n\nSet the collection variables before running:\n- baseUrl: the app root, e.g. https://host/AxpertWeb (no trailing slash)\n- cookie: the ASP.NET_SessionId cookie of a logged-in session (browser DevTools > Application > Cookies)\n- username / userRoles / userResp: the values the palette sends (window.mainUserName, AxUserRoles, userResp)\n- term: a word that appears in some structure captions (3+ characters)\n- pageSize: rows per page for the paging checks\n\nRun the requests in order: later requests compare against rows saved by earlier ones.\nPaging only works when the ADS SQL carries the --ax_pagination marker, and filters need --ax_ui_filter_withwhere;\nwithout them every row comes back and the size checks fail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR-HOST/YOUR-APP"
    },
    {
      "key": "cookie",
      "value": "ASP.NET_SessionId=PASTE_FROM_BROWSER"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "userRoles",
      "value": "default"
    },
    {
      "key": "userResp",
      "value": "default"
    },
    {
      "key": "term",
      "value": "user"
    },
    {
      "key": "pageSize",
      "value": "10"
    }
  ],
  "item": [
    {
      "name": "1. All rows (pagesize 0) - baseline",
      "request": {
        "method": "POST",
        "description": "pagesize 0 returns every row; its count is the baseline for the paging checks.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{cookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/aspx/AxPEG.aspx/GetDataFromAxList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "aspx",
            "AxPEG.aspx",
            "GetDataFromAxList"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"adsNames\": [\n    \"axi_structmetalist\"\n  ],\n  \"refreshCache\": true,\n  \"sqlParams\": {\n    \"param1\": \"{{username}}\",\n    \"param2\": \"{{userRoles}}\",\n    \"param3\": \"{{userResp}}\",\n    \"param4\": \"all\",\n    \"param5\": \"all\"\n  },\n  \"keyField\": \"\",\n  \"keyValue\": \"\",\n  \"props\": {\n    \"ADS\": true,\n    \"CachePermissions\": false,\n    \"getallrecordscount\": false,\n    \"pageno\": 1,\n    \"pagesize\": 0,\n    \"keyfield\": \"\",\n    \"keyvalue\": \"\",\n    \"AxClient_dateformat\": \"MM/dd/yyyy\",\n    \"select_columns\": [],\n    \"aggregations\": {},\n    \"groupby_columns\": []\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const outer = pm.response.json();",
              "let inner = outer && outer.d !== undefined ? outer.d : outer;",
              "if (typeof inner === 'string') { try { inner = JSON.parse(inner); } catch (e) { inner = { raw: inner }; } }",
              "const result = (inner && inner.result) || {};",
              "const block = (Array.isArray(result.data) && result.data[0]) || {};",
              "const rows = Array.isArray(block.data) ? block.data : [];",
              "const keyOf = r => String(r.transid || r.name || r.displaydata || JSON.stringify(r)).toLowerCase();",
              "console.log(pm.info.requestName + ': ' + rows.length + ' rows');",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('AxList reports success', () => pm.expect(result.success, JSON.stringify(inner).slice(0, 400)).to.eql(true));",
              "pm.collectionVariables.set('allCount', String(rows.length));",
              "pm.collectionVariables.set('allKeys', JSON.stringify(rows.map(keyOf)));",
              "pm.test('returns rows', () => pm.expect(rows.length).to.be.above(0));",
              "pm.test('more rows than one page, so paging can be seen', () => pm.expect(rows.length).to.be.above(Number(pm.collectionVariables.get('pageSize'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Total count (getallrecordscount)",
      "request": {
        "method": "POST",
        "description": "getallrecordscount true: the response should report the full count while returning one page.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
