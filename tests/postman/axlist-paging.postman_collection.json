              "const result = (inner && inner.result) || {};",
              "const block = (Array.isArray(result.data) && result.data[0]) || {};",
              "const rows = Array.isArray(block.data) ? block.data : [];",
              "const keyOf = r => String(r.transid || r.name || r.displaydata || JSON.stringify(r)).toLowerCase();",
              "console.log(pm.info.requestName + ': ' + rows.length + ' rows');",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('AxList reports success', () => pm.expect(result.success, JSON.stringify(inner).slice(0, 400)).to.eql(true));",
              "const term = pm.collectionVariables.get('term').toLowerCase();",
              "const all = Number(pm.collectionVariables.get('allCount'));",
              "pm.collectionVariables.set('filterCount', String(rows.length));",
              "pm.test('returns rows for the term (pick a term that exists)', () => pm.expect(rows.length).to.be.above(0));",
              "pm.test('every row contains the term (if this fails, the ADS has no --ax_ui_filter_withwhere marker)', () => rows.forEach(r => pm.expect(String(r.displaydata).toLowerCase()).to.include(term)));",
              "pm.test('fewer rows than the full list', () => pm.expect(rows.length).to.be.below(all));"
            ]
          }
        }
      ]
