              "pm.collectionVariables.set('page1Keys', JSON.stringify(rows.map(keyOf)));",
              "pm.test('returns at most one page (if this fails, the ADS has no --ax_pagination marker)', () => pm.expect(rows.length).to.be.at.most(size));",
