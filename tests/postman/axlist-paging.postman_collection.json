    {
      "name": "6. Filter, all rows",
      "request": {
        "method": "POST",
        "description": "displaydata CONTAINS {{term}}, pagesize 0: every row contains the term and the list is shorter than the full list.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{cookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/aspx/AxPEG.aspx/GetDataFromAxList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "aspx",
            "AxPEG.aspx",
            "GetDataFromAxList"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"adsNames\": [\n    \"axi_structmetalist\"\n  ],\n  \"refreshCache\": true,\n  \"sqlParams\": {\n    \"param1\": \"{{username}}\",\n    \"param2\": \"{{userRoles}}\",\n    \"param3\": \"{{userResp}}\",\n    \"param4\": \"all\",\n    \"param5\": \"all\"\n  },\n  \"keyField\": \"\",\n  \"keyValue\": \"\",\n  \"props\": {\n    \"ADS\": true,\n    \"CachePermissions\": false,\n    \"getallrecordscount\": false,\n    \"pageno\": 1,\n    \"pagesize\": 0,\n    \"keyfield\": \"\",\n    \"keyvalue\": \"\",\n    \"AxClient_dateformat\": \"MM/dd/yyyy\",\n    \"select_columns\": [],\n    \"aggregations\": {},\n    \"groupby_columns\": [],\n    \"filters\": [\n      {\n        \"fldname\": \"displaydata\",\n        \"condition\": \"CONTAINS\",\n        \"value\": \"{{term}}\",\n        \"datatype\": \"TEXT\"\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
