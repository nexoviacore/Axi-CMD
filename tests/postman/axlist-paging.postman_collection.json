              "pm.test('page 1 rows are rows of the full list', () => { const allKeys = new Set(JSON.parse(pm.collectionVariables.get('allKeys') || '[]')); rows.forEach(r => pm.expect(allKeys.has(keyOf(r)), keyOf(r)).to.eql(true)); });"
            ]
          }
        }
      ]
    },
