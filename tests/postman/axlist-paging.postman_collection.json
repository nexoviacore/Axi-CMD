          "raw": "{\n  \"adsNames\": [\n    \"axi_structmetalist\"\n  ],\n  \"refreshCache\": true,\n  \"sqlParams\": {\n    \"param1\": \"{{username}}\",\n    \"param2\": \"{{userRoles}}\",\n    \"param3\": \"{{userResp}}\",\n    \"param4\": \"all\",\n    \"param5\": \"all\"\n  },\n  \"keyField\": \"\",\n  \"keyValue\": \"\",\n  \"props\": {\n    \"ADS\": true,\n    \"CachePermissions\": false,\n    \"getallrecordscount\": true,\n    \"pageno\": 1,\n    \"pagesize\": {{pageSize}},\n    \"keyfield\": \"\",\n    \"keyvalue\": \"\",\n    \"AxClient_dateformat\": \"MM/dd/yyyy\",\n    \"select_columns\": [],\n    \"aggregations\": {},\n    \"groupby_columns\": []\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const outer = pm.response.json();",
              "let inner = outer && outer.d !== undefined ? outer.d : outer;",
              "if (typeof inner === 'string') { try { inner = JSON.parse(inner); } catch (e) { inner = { raw: inner }; } }",
              "const result = (inner && inner.result) || {};",
              "const block = (Array.isArray(result.data) && result.data[0]) || {};",
              "const rows = Array.isArray(block.data) ? block.data : [];",
              "const keyOf = r => String(r.transid || r.name || r.displaydata || JSON.stringify(r)).toLowerCase();",
              "console.log(pm.info.requestName + ': ' + rows.length + ' rows');",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('AxList reports success', () => pm.expect(result.success, JSON.stringify(inner).slice(0, 400)).to.eql(true));",
              "const all = Number(pm.collectionVariables.get('allCount'));",
              "const counts = [block.recordcount, block.totalrecords, block.totalcount, block.count, result.recordcount, result.totalrecords, result.totalcount].filter(v => v !== undefined && v !== null && v !== '');",
              "console.log('count fields: ' + JSON.stringify(counts) + ' | block keys: ' + Object.keys(block).join(',') + ' | result keys: ' + Object.keys(result).join(','));",
              "pm.test('a total count is reported', () => pm.expect(counts.length, 'no count field found; see the console for the keys').to.be.above(0));",
              "pm.test('the total count equals the all-rows count', () => pm.expect(Number(counts[0])).to.eql(all));"
            ]
          }
        }
      ]
    },
