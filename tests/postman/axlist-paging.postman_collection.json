          "raw": "{\n  \"adsNames\": [\n    \"axi_structmetalist\"\n  ],\n  \"refreshCache\": true,\n  \"sqlParams\": {\n    \"param1\": \"{{username}}\",\n    \"param2\": \"{{userRoles}}\",\n    \"param3\": \"{{userResp}}\",\n    \"param4\": \"all\",\n    \"param5\": \"all\"\n  },\n  \"keyField\": \"\",\n  \"keyValue\": \"\",\n  \"props\": {\n    \"ADS\": true,\n    \"CachePermissions\": false,\n    \"getallrecordscount\": false,\n    \"pageno\": 2,\n    \"pagesize\": 2,\n    \"keyfield\": \"\",\n    \"keyvalue\": \"\",\n    \"AxClient_dateformat\": \"MM/dd/yyyy\",\n    \"select_columns\": [],\n    \"aggregations\": {},\n    \"groupby_columns\": [],\n    \"filters\": [\n      {\n        \"fldname\": \"displaydata\",\n        \"condition\": \"CONTAINS\",\n        \"value\": \"{{term}}\",\n        \"datatype\": \"TEXT\"\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const outer = pm.response.json();",
              "let inner = outer && outer.d !== undefined ? outer.d : outer;",
              "if (typeof inner === 'string') { try { inner = JSON.parse(inner); } catch (e) { inner = { raw: inner }; } }",
              "const result = (inner && inner.result) || {};",
              "const block = (Array.isArray(result.data) && result.data[0]) || {};",
              "const rows = Array.isArray(block.data) ? block.data : [];",
              "const keyOf = r => String(r.transid || r.name || r.displaydata || JSON.stringify(r)).toLowerCase();",
              "console.log(pm.info.requestName + ': ' + rows.length + ' rows');",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('AxList reports success', () => pm.expect(result.success, JSON.stringify(inner).slice(0, 400)).to.eql(true));",
              "const term = pm.collectionVariables.get('term').toLowerCase();",
              "const filtered = Number(pm.collectionVariables.get('filterCount'));",
              "const page1 = new Set(JSON.parse(pm.collectionVariables.get('filterPage1Keys') || '[]'));",
              "pm.test('returns the expected number of rows for filtered page 2', () => pm.expect(rows.length).to.eql(Math.max(0, Math.min(2, filtered - 2))));",
              "pm.test('every row contains the term', () => rows.forEach(r => pm.expect(String(r.displaydata).toLowerCase()).to.include(term)));",
              "pm.test('no row of filtered page 1 comes back', () => rows.forEach(r => pm.expect(page1.has(keyOf(r)), keyOf(r)).to.eql(false)));"
            ]
          }
        }
      ]
