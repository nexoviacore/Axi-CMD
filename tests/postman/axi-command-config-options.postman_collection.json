          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"reactivated option is served again\", () => pm.expect(pm.response.json().map(r => r.configId)).to.include(pm.variables.get(\"configId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config?appname={{appname}}&username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            },
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
