{
  "info": {
    "name": "AxiApi command-config options (tickets 283, 284, 285)",
    "description": "Read-only list of every Configure and SDK option, inactive ones included, with is_system (isSystem) and the record source name. Set variables: axiApiUrl (e.g. https://host/AxiCMDApi), appname, username. Needs a database that ran axi_command_config.sql (ticket 282). Ticket 284 adds the Active switch (PUT .../options/{configId}/active). Run the folder in order: it deactivates the option in variable configId, checks the read cache is fresh, then reactivates it. Variable configId must be a shipped Configure or SDK option. Ticket 285 adds POST .../options (create a Custom Option of type url): run the 285 requests in order after the 284 ones. They check the access refusal, name rules (comma, blank, 201 characters, duplicate in another case including a Built-in name), the type and URL rules, then create \"Postman Audit <timestamp>\", read it back through GET command-config and the options list (record sources of existing options unchanged = lists still paired) and finally switch the new option off. Each run leaves one inactive Custom Option behind: there is no delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "axiApiUrl",
      "value": "https://YOUR-HOST/AxiCMDApi"
    },
    {
      "key": "appname",
      "value": "YOUR-APP"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "configId",
      "value": "cfg_configure_roles"
    },
    {
      "key": "customName",
      "value": ""
    },
    {
      "key": "newConfigId",
      "value": ""
    },
    {
      "key": "sourcesBefore",
      "value": "{}"
    }
  ],
  "item": [
    {
      "name": "list all options",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test('array of rows', () => pm.expect(rows).to.be.an('array').that.is.not.empty);",
              "pm.test('only Configure and SDK', () => rows.forEach(r => pm.expect(['configure', 'sdk']).to.include(r.command.toLowerCase())));",
              "pm.test('every row has isSystem T or F', () => rows.forEach(r => pm.expect(['T', 'F']).to.include(r.isSystem)));",
              "pm.test('both tabs present', () => { const c = rows.map(r => r.command.toLowerCase()); pm.expect(c).to.include('configure'); pm.expect(c).to.include('sdk'); });",
              "pm.test('active flag is T or F (inactive rows are returned)', () => rows.forEach(r => pm.expect(['T', 'F']).to.include(r.active)));",
              "pm.test('Configure user has a record source', () => { const u = rows.find(r => r.command === 'Configure' && r.promptOptions === 'user'); pm.expect(u, 'cfg_configure_user').to.exist; pm.expect(u.recordSource).to.eql('axi_userlist'); pm.expect(u.isSystem).to.eql('T'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options?appname={{appname}}&username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            },
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
