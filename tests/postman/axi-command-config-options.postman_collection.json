      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"active\":true,\"appMgrAccess\":true}"
        },
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options/{{configId}}/active?appname={{appname}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options",
            "{{configId}}",
            "active"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            }
          ]
