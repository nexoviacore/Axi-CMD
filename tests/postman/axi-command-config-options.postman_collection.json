{
  "info": {
    "name": "AxiApi command-config options (tickets 283, 284)",
    "description": "Read-only list of every Configure and SDK option, inactive ones included, with is_system (isSystem) and the record source name. Set variables: axiApiUrl (e.g. https://host/AxiCMDApi), appname, username. Needs a database that ran axi_command_config.sql (ticket 282). Ticket 284 adds the Active switch (PUT .../options/{configId}/active). Run the folder in order: it deactivates the option in variable configId, checks the read cache is fresh, then reactivates it. Variable configId must be a shipped Configure or SDK option.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "axiApiUrl",
      "value": "https://YOUR-HOST/AxiCMDApi"
    },
    {
      "key": "appname",
      "value": "YOUR-APP"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "configId",
      "value": "cfg_configure_roles"
    }
  ],
  "item": [
    {
      "name": "list all options",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test('array of rows', () => pm.expect(rows).to.be.an('array').that.is.not.empty);",
              "pm.test('only Configure and SDK', () => rows.forEach(r => pm.expect(['configure', 'sdk']).to.include(r.command.toLowerCase())));",
              "pm.test('every row has isSystem T or F', () => rows.forEach(r => pm.expect(['T', 'F']).to.include(r.isSystem)));",
              "pm.test('both tabs present', () => { const c = rows.map(r => r.command.toLowerCase()); pm.expect(c).to.include('configure'); pm.expect(c).to.include('sdk'); });",
              "pm.test('active flag is T or F (inactive rows are returned)', () => rows.forEach(r => pm.expect(['T', 'F']).to.include(r.active)));",
              "pm.test('Configure user has a record source', () => { const u = rows.find(r => r.command === 'Configure' && r.promptOptions === 'user'); pm.expect(u, 'cfg_configure_user').to.exist; pm.expect(u.recordSource).to.eql('axi_userlist'); pm.expect(u.isSystem).to.eql('T'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options?appname={{appname}}&username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            },
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
    {
      "name": "missing appname is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options?username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 refused without appMgrAccess",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"403 with a readable message\", () => { pm.response.to.have.status(403); pm.expect(pm.response.text()).to.match(/Configure Access/); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"active\":false,\"appMgrAccess\":false}"
        },
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options/{{configId}}/active?appname={{appname}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options",
            "{{configId}}",
            "active"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 refused when appMgrAccess is missing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"403 with a readable message\", () => { pm.response.to.have.status(403); pm.expect(pm.response.text()).to.match(/Configure Access/); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"active\":false}"
        },
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options/{{configId}}/active?appname={{appname}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options",
            "{{configId}}",
            "active"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 option still active after the refusals",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"unchanged\", () => { const r = pm.response.json().find(x => x.configId === pm.variables.get(\"configId\")); pm.expect(r, \"configId\").to.exist; pm.collectionVariables.set(\"wasActive\", r.active); pm.collectionVariables.set(\"optionCount\", String(pm.response.json().length)); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options?appname={{appname}}&username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            },
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 deactivate with appMgrAccess",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"reports F\", () => pm.expect(pm.response.json().active).to.eql(\"F\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"active\":false,\"appMgrAccess\":true}"
        },
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options/{{configId}}/active?appname={{appname}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options",
            "{{configId}}",
            "active"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 GET command-config is fresh (option gone)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"deactivated option is not served (cache cleared)\", () => pm.expect(pm.response.json().map(r => r.configId)).to.not.include(pm.variables.get(\"configId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config?appname={{appname}}&username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            },
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 options list shows F and the same options",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"row is inactive\", () => { const rows = pm.response.json(); const r = rows.find(x => x.configId === pm.variables.get(\"configId\")); pm.expect(r.active).to.eql(\"F\"); pm.expect(String(rows.length)).to.eql(pm.collectionVariables.get(\"optionCount\")); pm.expect(r.recordSource, \"prompt source untouched\").to.be.a(\"string\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{axiApiUrl}}/api/v1/Axi/command-config/options?appname={{appname}}&username={{username}}",
          "host": [
            "{{axiApiUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "Axi",
            "command-config",
            "options"
          ],
          "query": [
            {
              "key": "appname",
              "value": "{{appname}}"
            },
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      }
    },
    {
      "name": "284 reactivate with appMgrAccess",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"reports T\", () => pm.expect(pm.response.json().active).to.eql(\"T\"));"
            ]
